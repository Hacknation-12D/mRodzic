# Skopiuj do `.env`. Aplikacja działa BEZ tego pliku (seed + asystent mock).

# --- Aplikacja (publiczne, trafiają do bundla) ---
# URL i klucz anon z Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# mock | remote (remote wymaga Supabase + wdrożonej Edge Function `assistant`)
EXPO_PUBLIC_ASSISTANT_MODE=mock
# SQLite demo: adres API z README_INTEGRACJA.md, np. http://127.0.0.1:8765 na komputerze.
# Puste = logowanie na wbudowanym src/dev/dummyData/mrodzic_compat_profiles_v1.json (bez serwera).
EXPO_PUBLIC_DEMO_API_URL=

# --- Tylko skrypty Node (content:import / content:export). NIGDY w aplikacji. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Asystent AI (tylko na czas testów – EXPO_PUBLIC_* trafia do bundla) ---
# Dostawcę (AI_PROVIDER: openai | deepseek) i modele ustawiasz w settings.json
EXPO_PUBLIC_DEEPSEEK_API_KEY=
EXPO_PUBLIC_OPENAI_API_KEY=
