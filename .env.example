# Skopiuj do `.env`. Aplikacja działa BEZ tego pliku (seed + asystent mock).

# --- Aplikacja (publiczne, trafiają do bundla) ---
# URL i klucz anon z Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# mock | remote (remote wymaga Supabase + wdrożonej Edge Function `assistant`)
EXPO_PUBLIC_ASSISTANT_MODE=mock
# ania | magda | kasia – wczytuje personę przy pierwszym starcie (pomija onboarding)
EXPO_PUBLIC_SEED_PERSONA=
EXPO_PUBLIC_ENABLE_TEST_LOGIN=false

# --- Tylko skrypty Node (content:import / content:export). NIGDY w aplikacji. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Wyłącznie dla kont demonstracyjnych w osobnym projekcie testowym online.
SUPABASE_TEST_PROJECT_REF=
SUPABASE_TEST_USERS_PASSWORD=
